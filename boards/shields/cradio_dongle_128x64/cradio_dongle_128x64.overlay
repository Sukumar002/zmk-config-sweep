#include <dt-bindings/pinctrl/nrf-pinctrl.h>
/*
 * Sweep dongle central: no local key matrix.
 * SSD1306 is wired to the nice!nano Pro Micro I2C pins.
 */
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zephyr,display = &oled;
    };

    /*
     * Match the physical-layout and transform identifiers used by the
     * Sweep halves. Studio requires the same layout metadata on the dongle
     * even though this device has no physical keys.
     */
    cuddlykeyboards_ferris_layout: cuddlykeyboards_ferris_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;
        keys =
            <&key_physical_attrs 100 100 0 95 0 0 0>,
                        <&key_physical_attrs 100 100 100 32 0 0 0>,
                        <&key_physical_attrs 100 100 200 0 0 0 0>,
                        <&key_physical_attrs 100 100 300 28 0 0 0>,
                        <&key_physical_attrs 100 100 400 42 0 0 0>,
                        <&key_physical_attrs 100 100 700 42 0 0 0>,
                        <&key_physical_attrs 100 100 800 28 0 0 0>,
                        <&key_physical_attrs 100 100 900 0 0 0 0>,
                        <&key_physical_attrs 100 100 1000 32 0 0 0>,
                        <&key_physical_attrs 100 100 1100 95 0 0 0>,
                        <&key_physical_attrs 100 100 0 195 0 0 0>,
                        <&key_physical_attrs 100 100 100 132 0 0 0>,
                        <&key_physical_attrs 100 100 200 100 0 0 0>,
                        <&key_physical_attrs 100 100 300 129 0 0 0>,
                        <&key_physical_attrs 100 100 400 142 0 0 0>,
                        <&key_physical_attrs 100 100 700 142 0 0 0>,
                        <&key_physical_attrs 100 100 800 129 0 0 0>,
                        <&key_physical_attrs 100 100 900 100 0 0 0>,
                        <&key_physical_attrs 100 100 1000 132 0 0 0>,
                        <&key_physical_attrs 100 100 1100 195 0 0 0>,
                        <&key_physical_attrs 100 100 0 295 0 0 0>,
                        <&key_physical_attrs 100 100 100 231 0 0 0>,
                        <&key_physical_attrs 100 100 200 200 0 0 0>,
                        <&key_physical_attrs 100 100 300 229 0 0 0>,
                        <&key_physical_attrs 100 100 400 242 0 0 0>,
                        <&key_physical_attrs 100 100 700 242 0 0 0>,
                        <&key_physical_attrs 100 100 800 229 0 0 0>,
                        <&key_physical_attrs 100 100 900 200 0 0 0>,
                        <&key_physical_attrs 100 100 1000 231 0 0 0>,
                        <&key_physical_attrs 100 100 1100 295 0 0 0>,
                        <&key_physical_attrs 330 100 330 355 1500 430 455>,
                        <&key_physical_attrs 330 100 430 355 3000 430 455>,
                        <&key_physical_attrs 330 100 670 355 (-3000) 770 455>,
                        <&key_physical_attrs 330 100 770 355 (-1500) 770 455>
        ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <34>;
        rows = <1>;
        map = <
            0 1 2 3 4 21 20 19 18 17
            5 6 7 8 9 26 25 24 23 22
            10 11 12 13 14 31 30 29 28 27
            15 16 33 32
        >;
    };

    /*
     * The original keymap contains a pin override for &kscan0. Keep a
     * disabled GPIO scanner node so that override remains valid.
     */
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-direct";
        status = "disabled";
    };

    mock_kscan: kscan1 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};

/* Dongle-only I2C pin remap. The peripheral shield overlays are untouched. */
&pinctrl {
    dongle_i2c0_default: dongle_i2c0_default {
        group1 {
            /* SDA = P0.06 (D0), SCL = P0.08 (D1) on the dongle MCU only. */
            psels = <NRF_PSEL(TWIM_SDA, 0, 6)>,
                    <NRF_PSEL(TWIM_SCL, 0, 8)>;
        };
    };

    dongle_i2c0_sleep: dongle_i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 6)>,
                    <NRF_PSEL(TWIM_SCL, 0, 8)>;
            low-power-enable;
        };
    };
};

&pro_micro_i2c {
    status = "okay";
    pinctrl-0 = <&dongle_i2c0_default>;
    pinctrl-1 = <&dongle_i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;

        width = <128>;
        height = <64>;

        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;

        segment-remap;
        com-invdir;
        prechargep = <0x22>;
    };
};
