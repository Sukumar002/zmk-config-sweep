/*
 * Sweep dongle central: the dongle has no local key matrix.
 * The SSD1306 is wired to the nice!nano Pro Micro I2C pins.
 */

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zephyr,display = &oled;
    };

    /*
     * The original cradio.keymap contains a pin override for &kscan0.
     * Keep a disabled GPIO scanner node so that override remains valid,
     * while the dongle itself uses the mock scanner below.
     */
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-direct";
        status = "disabled";
    };

    mock_kscan: kscan1 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};

&pro_micro_i2c {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;

        width = <128>;
        height = <64>;

        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;

        segment-remap;
        com-invdir;
        prechargep = <0x22>;
    };
};
